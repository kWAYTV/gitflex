# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Pooled Postgres connection used by applications at runtime
# @type=string(startsWith=postgres)
DATABASE_URL=

# Direct (non-pooled) Postgres connection used by migrations
# @type=string(startsWith=postgres)
DATABASE_URL_UNPOOLED=

# TCP Redis connection (redis:// or rediss://) used by BullMQ
# @type=string(startsWith=redis)
REDIS_URL=
