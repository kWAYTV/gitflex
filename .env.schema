# @defaultRequired=true
# @defaultSensitive=true
# @currentEnv=$NODE_ENV
# ---

# @public @type=enum(development, production, test)
NODE_ENV=development

# Pooled Postgres connection used by applications at runtime
# @type=string(startsWith=postgres)
DATABASE_URL=

# Direct (non-pooled) Postgres connection used by migrations
# @type=string(startsWith=postgres)
DATABASE_URL_UNPOOLED=

# TCP Redis connection (redis:// or rediss://) used by BullMQ
# @type=string(startsWith=redis)
REDIS_URL=

# Better Auth secret; also the OAuth token encryption key, so web and worker must share it
# @type=string(minLength=32)
BETTER_AUTH_SECRET=

# Public origin of the web app
# @sensitive=false @type=url
BETTER_AUTH_URL=http://localhost:3001

# @sensitive=false
GITHUB_CLIENT_ID=

GITHUB_CLIENT_SECRET=
