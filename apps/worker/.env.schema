# @sensitive=false @type=port
WORKER_HEALTH_PORT=3002

# Repositories analyzed in parallel within one scan job
# @sensitive=false @type=number(min=1, max=10)
SCAN_REPOSITORY_CONCURRENCY=3

# Scan jobs processed in parallel by this worker process
# @sensitive=false @type=number(min=1, max=20)
SCAN_JOB_CONCURRENCY=2
